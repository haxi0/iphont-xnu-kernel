    out.append(('python syntax', r.returncode == 0, r.stderr.strip()[-200:]))
    r = sh('python3 tools/wakeperf/report.py --self-test')
    out.append(('report.py self-test', r.returncode == 0, r.stdout.strip() or r.stderr.strip()[-200:]))
    r = sh('python3 -I tools/sched-test/amp.py --self-test && bash -n tools/sched-test/qemu.sh')
    out.append(('sched-test amp.py self-test', r.returncode == 0, r.stdout.strip() or r.stderr.strip()[-200:]))
