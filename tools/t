def say(text=''):
    print(text, flush=True)


def check(name, ok, detail=''):
    verdicts.append((name, ok))
    say(f'  {"PASS" if ok else "FAIL"}  {name}{": " + detail if detail else ""}')


def sh(cmd, **kw):
    return subprocess.run(cmd, shell=isinstance(cmd, str), text=True, capture_output=True, **kw)


def timed(name):
    class T:
        def __enter__(self):
            self.t = time.time()

        def __exit__(self, *a):
            times[name] = time.time() - self.t
    return T()


