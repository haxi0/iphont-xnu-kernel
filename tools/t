# ---- builds, cached by what they are made of ------------------------------------------------------------------------
def kernel_stale():
    binary = 'xnu-src/xnu-8796.121.2/BUILD/obj/DEVELOPMENT_ARM64_BCM2837/mach.development.bcm2837'
    if not os.path.exists(binary):
        return True
    dirs = ' '.join(f'xnu-src/xnu-8796.121.2/{d}' for d in ('bsd', 'osfmk', 'iokit', 'libkern', 'pexpert', 'config', 'EXTERNAL_HEADERS'))
    r = sh(f'find {dirs} -type f -newer {binary} \\( -name "*.c" -o -name "*.cpp" -o -name "*.h" -o -name "*.s" -o -name "*.S" -o -name "*.m" \\) -print -quit')
    return bool(r.stdout.strip())


def build_kernel():
    if not kernel_stale():
        return 'kernel up to date'
    r = sh("nix-shell --run 'SKIP=\"loader images boot\" common/build.sh instantnoodle'")
    if kernel_stale():      # the build ends in an error that is expected (xnu/README.md), so judge by the binary: still older than the sources = failed
        errors = [l for l in open('out/kernel-build.log', errors='replace') if ' error: ' in l]
        return 'KERNEL BUILD FAILED: ' + (errors[0].strip()[-300:] if errors else r.stderr[-300:])
    return 'kernel built'


def userland_hash(jobs):
    h = hashlib.sha256()
    h.update(jobs.encode())
    for base, _, files in sorted(os.walk('userland/src')):
        for f in sorted(files):
            with open(os.path.join(base, f), 'rb') as fh:
                h.update(f.encode() + fh.read())
    for f in ('userland/build.sh', 'userland/mkjobs.py', 'userland/init.c' if os.path.exists('userland/init.c') else 'userland/build.sh'):
        with open(f, 'rb') as fh:
            h.update(fh.read())
    return h.hexdigest()[:16]


# userland/build.sh's default INJECT, and MobileSafari given the layer dump (src/inject_sb.c: com.hackios.layers) for `safari`
INJECT = ('/hackios/lib/libhackios.dylib backboardd containermanagerd containermanagerd_system\n'
          '/hackios/lib/libhackios-sb.dylib SpringBoard MobileSafari CalendarWidgetExtension WeatherWidget chronod\n/hackios/lib/libhackios-media.dylib mediaserverd\n'
          '/hackios/lib/libhackios-app.dylib Sileo\n/hackios/lib/libhackios-tweaks.dylib Preferences')


def build_userland(jobs):
    """(root.apfs, flashboot.apfs) for this job and these sources: from the cache, or built once."""
    cache = f'out/tcache/{userland_hash(jobs)}'
    if os.path.exists(f'{cache}/root.apfs'):
        return cache, 'userland from the cache'
    with open('userland/rc.jobs.t', 'w') as f:
        f.write(jobs)
    env = dict(os.environ, INJECT=INJECT) if any(w in jobs for w in ('MobileSafari', 'mobilesafari', 'widgetprof', 'wakeprof', 'prof.start')) else None
    r = subprocess.run("nix-shell --run 'GL=1 REST=1 FLASHBOOT=1 CRYPTEXES=flash RC_JOBS=rc.jobs.t userland/build.sh'", shell=True, text=True, capture_output=True, env=env)
    if r.returncode != 0 or not os.path.exists('userland/flashboot.apfs'):
        return None, 'USERLAND BUILD FAILED: ' + (r.stderr or r.stdout)[-400:]
    os.makedirs(cache, exist_ok=True)
    for name in ('root.apfs', 'flashboot.apfs'):
        shutil.copy(f'userland/{name}', f'{cache}/{name}')
    return cache, 'userland built'


# ---- the run ------------------------------------------------------------------------------------------------------
def job_text(names):
    lines = ['# generated by tools/t: ' + ' '.join(names)]
    est = 0
    for n in names:
        lines += CHECKS[n][0]
        est += CHECKS[n][1]
    lines.append(f'{RW} mark done')
    return '\n'.join(lines) + '\n', est


def watch(logfile, state):
    """While the run lives: a screenshot at each `t-mark: shot-NAME`, and the boot's progress (stuck: stop it)."""
    seen, began = set(), time.time()
    sizes = []
    while not state['over']:
        time.sleep(0.5)
        try:
            text = open(logfile, 'rb').read().decode('utf-8', 'replace')
        except OSError:
            continue
        sizes.append((time.time(), len(text)))
        for m in re.finditer(r't-mark: (shot-[\w-]+)', text):
            if m.group(1) not in seen:
                seen.add(m.group(1))
                target = f'logs/t-{state["stamp"]}-{m.group(1)[5:]}.png'
                r = sh(f'./xl screenshot {target}')
                state['shots'][m.group(1)[5:]] = target if os.path.exists(target) else None
        if state['booted'] is not None or 't-mark: boot-ok' in text:
            state['booted'] = state['booted'] if state['booted'] is not None else time.time() - began
        elif not state['stopped']:
            age = time.time() - began
            grew = len(text) > next((n for t, n in sizes if t >= time.time() - 20), len(text))
            if age > BOOT_SLOW_S or (age > BOOT_STUCK_S and not grew):
                state['stopped'] = f'no settled SpringBoard after {age:.0f} s, log {"still growing" if grew else "not growing"}'
                sh('./xl stop')


def run_phone(cache, names, est, max_s, stamp):
    state = dict(over=False, stopped=None, booted=None, shots={}, stamp=stamp)
    sleeps = 5 + sum(5 for n in names if n.startswith('sleep') or n == 'powerd') + 15
    env = dict(os.environ, XL_SECS=str(max_s or int(est + 60 + sleeps)), XL_DONE='t-mark: done', XL_FOLLOW_KEEP='1',
               XL_RAMDISK=f'{cache}/root.apfs', XL_CMDLINE=f'{BOOTARGS.replace("log_launchd=0", "") if os.environ.get("T_LAUNCHD") else BOOTARGS} sleep_max={max(8, 15 + 5)} ' + os.environ.get('T_BOOTARGS', ''))
    sh(f'./xl wait 600')
    r = sh(f'./xl ramdisk {cache}/flashboot.apfs')
    if r.returncode != 0:
        return None, state, 'upload failed: ' + (r.stdout + r.stderr)[-200:]
    before = set(os.listdir('logs'))
    th = None
    p = subprocess.Popen('./xl run', shell=True, env=env, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    for _ in range(100):                      # the log's name is the run's start: wait for it to appear
        time.sleep(0.2)
        fresh = sorted(f for f in set(os.listdir('logs')) - before if f.endswith('-run.log.live'))
        if fresh:
            break
    live = 'logs/' + fresh[0] if fresh else None
    if live:
        th = threading.Thread(target=watch, args=(live, state), daemon=True)
        th.start()
    out = p.communicate()[0]
    state['over'] = True
    if th:
        th.join(2)
    log = next((l for l in re.findall(r'\[(logs/[\w.-]+)\]', out)), None)
    return log, state, out.strip()


def run_files(log):
    """The run's log and every live copy of it (the log itself loses its middle past a megabyte; the copies, one every 2 s, keep it)."""
    if not log:
        return []
    base = os.path.basename(log)
    return [log] + sorted((f'logs/{f}' for f in os.listdir('logs') if f.startswith(base + '.live')), key=os.path.getmtime)


def analyze(names, log, state, out):
    files = run_files(log)
    text = ''.join(open(f, 'rb').read().decode('utf-8', 'replace') for f in files)
    say(f'  run: {out.splitlines()[-1][:160] if out else "(no output)"}')
    if state['stopped']:
        check('boot', False, state['stopped'])
        say('  evidence (last kernel lines):')
        for line in [l for l in text.splitlines() if l.startswith('[') and 'panic_trace' not in l][-12:]:
            say('    ' + line[:160])
        return
    if 'boot' in names:
        panics = [l for l in text.splitlines() if re.search(r'panic\(|Kernel panic|PANIC', l) and 'panic_trace' not in l]
        gone = 'THE GPU IS NOT STARTED' in text or 'THE GPU IS LOST' in text
        if gone:
            check('gpu', False, 'the GPU did not start or was lost: ' + next(l for l in text.splitlines() if 'THE GPU IS NOT STARTED' in l or 'THE GPU IS LOST' in l)[:160])
        up = re.search(r'rwtouch: frames: reached after ([\d.]+) s \((\d+) a second\)', text)
        check('boot', state['booted'] is not None and bool(up) and not panics,
              f'the window server draws {up.group(2)} frames a second, {up.group(1)} s after the job began; CPU settled' if up else
              'the home screen never drew 20 frames a second' + (f'; {panics[0][:120]}' if panics else ''))
    if 'pods' in names:
        shot = state['shots'].get('library')
        if not shot:
            check('pods', False, 'no screenshot taken')
        else:
            r = sh(f"nix-shell -p python3Packages.numpy python3Packages.pillow --run 'python3 tools/look/check.py pods {shot}' 2>&1 | grep -v Using")
            check('pods', 'PASS' in r.stdout, r.stdout.strip().split(': ', 1)[-1])
    sleeps = re.findall(r't-sleep: (PASS|FAIL) ([^\n]*)', text)
    sleeps = list(dict.fromkeys(sleeps))
    want = 2 * ('sleep' in names) + ('sleep1' in names) + ('darkwake' in names) + 5 * ('sleep_rapid' in names) + ('powerd' in names)
    if want:
        bad = [s for s in sleeps if s[0] == 'FAIL']
        mem = {k: int(v) for k, v in re.findall(r't-mem: (before|after) (\d+) MB/s', text)}
        if 'before' in mem and 'after' in mem:
            check('memory after wake', mem['after'] >= 0.8 * mem['before'], f'{mem["after"]} MB/s after the sleeps, {mem["before"]} before')
        gsleep = re.findall(r'adreno: sleep: the GPU block is given back \(CX (\w+), GX (\w+)\) in (\d+) ms', text)
        gwake = re.findall(r'adreno: wake: the GPU block is started again (\(takes commands\)|FAILED) in (\d+) ms', text)
        if 'gpu_sleep=0' not in os.environ.get('T_BOOTARGS', ''):
            on = [x for x in gsleep if x[:2] != ('off', 'off')]
            lost = [w for w in gwake if 'takes commands' not in w[0]]
            ms = sorted(int(m) for _, m in gwake)
            check('gpu power in sleep', bool(gsleep) and bool(gwake) and not on and not lost,
                  f'CX and GX off in every sleep; started again in {ms[0]}-{ms[-1]} ms and takes commands' if gsleep and gwake and not on and not lost else
                  f'sleeps with the block on: {on[:2]}; wakes: {lost[:2] or gwake[:2]}; none seen' if not (gsleep and gwake) else f'{on[:2]} {lost[:2]}')
        check('sleep', len(sleeps) >= want and not bad, f'{len(sleeps) - len(bad)} of {want} passed' + (f'; {bad[0][1]}' if bad else '') +
              (f'; e.g. {sleeps[0][1]}' if sleeps and not bad else ''))
        # what a lit panel and a working display look like after the wakes: no fallback to the firmware's autorefresh
        fallbacks = [l for l in text.splitlines() if 'autorefresh back' in l or 'did not come' in l]
        check('display after wake', not fallbacks, fallbacks[0][:140] if fallbacks else 'no push fell back, none lost its interrupt')
    if 'frames' in names:
        import report
        phases = report.report(files)
        for number, gestures, s in phases:
            if s:
                say(f'  frames phase {number}: {s["frames"]} frames, {s["fps"]:.1f} fps, p50 {s["p50"]:.1f} p95 {s["p95"]:.1f} p99 {s["p99"]:.1f} ms, {s["late"]:.1f}% late, {s["missed"]} refreshes missed')
        frames_phases = [ph for ph in phases if ph[2]]
        if names.count('frames') >= 2:
            for ok, why in report.verdict(frames_phases):
                check('frames after sleep', ok, why)
        else:
            check('frames', len(frames_phases) >= 1 and frames_phases[0][2]['fps'] > 40, 'frame pacing measured' if frames_phases else 'no frames')
    if 'brightness' in names:
        got = {k: (int(v), int(w)) for k, v, w in re.findall(r't-backlight: (\w+) value (\d+) writes (\d+)', text)}
        want = {'20': 0x7ff * 0.2 ** 2, '90': 0x7ff * 0.9 ** 2, '5': 0x7ff * 0.05 ** 2, '100': 0x7ff}
        bad = [f'{k}%: panel value {got[k][0]:#x}, want about {int(w):#x}' for k, w in want.items()
               if k in got and abs(got[k][0] - w) > 0.03 * 0x7ff + 2]
        missing = [k for k in want if k not in got]
        writes = [got[k][1] for k in ('20', '90', '5', 'woken', '100') if k in got]
        check('brightness', not bad and not missing and len(writes) == 5 and all(b > a for a, b in zip(writes, writes[1:])),
              '; '.join(bad + [f'no {m}% reading' for m in missing]) if bad or missing else
              f'iOS levels 20/90/5/100% reached the panel as {" ".join(hex(got[k][0]) for k in ("20", "90", "5", "100"))}; the DSI link took '
              f'{writes[-1] if writes else "?"} writes, one more after the wake (the value is sent again when the panel is lit)')
    if 'powerd' in names:
        sp = {k: [int(x) for x in re.findall(r'speed (\d+)', v)] for k, v in re.findall(r't-cpu: (\w+) (.*)', text)}
        if 'before' in sp and 'later' in sp and sp['before'] and len(sp['before']) == len(sp['later']):
            ratio = [b and l / b for b, l in zip(sp['before'], sp['later'])]
            check('cpu speed after wake', min(ratio) >= 0.85,
                  'a core of each group runs at ' + ' '.join(f'{r:.0%}' for r in ratio) + f' of its speed before the sleep (just after the wake: {sp.get("wake")}, before: {sp["before"]}, later: {sp["later"]})')
        else:
            check('cpu speed after wake', False, f'no cpu readings: {sp}')
    if 'darkwake' in names:
        m = re.search(r't-mark: darkwake(.*?)t-display: on (reached|NOT reached) after ([\d.]+) s', text, re.S)
        check('light after dark wake', bool(m) and m.group(2) == 'reached',
              f'the lock button lit the screen after {m.group(3)} s' if m and m.group(2) == 'reached' else
              'a press of the lock button after a dark (timer) wake of a locked phone did not light the screen' + (f' in {m.group(3)} s' if m else ''))
    if any(n in names for n in ('sched', 'amp', 'schedpi', 'schedframes')):
        for line in dict.fromkeys(re.findall(r't-sched: ([^\n]*)', text)):
            say(f'  sched: {line[:200]}')
        m = re.findall(r't-sched: check passed=(\d+) failed=(\d+)', text)
        if 'sched' in names:
            check('sched checks', bool(m) and m[-1][1] == '0' and int(m[-1][0]) > 0,
                  f'the kernel\'s scheduler checks: {m[-1][0]} passed, {m[-1][1]} failed' if m else 'no result')
            bad = [l for l in text.splitlines() if 'sched_check: FAIL' in l]
            for l in list(dict.fromkeys(bad))[:6]:
                say('    ' + l[l.find('sched_check'):][:180])
        amp = [l for l in text.splitlines() if 't-amp ' in l]
        if amp:
            path = f'logs/t-{state.get("stamp", "x")}-amp.txt'
            with open(path, 'w') as f:
                f.write('\n'.join(dict.fromkeys(l[l.find('t-amp '):] for l in amp)) + '\n')
            say(f'  kernel scheduler snapshots: {path} (tools/sched-test/amp.py {path})')
    if 'idle' in names:
        m = re.findall(r'power_test: panel (\w+).*?awake (\d+) s', text)
        rows = re.findall(r'cpufreq: over the last \d+ ticks the groups ran at rows ([^;]*);', text)
        check('idle', bool(rows), f'governor rows at idle: {rows[-1]}' if rows else 'no governor line in the log')


def main():
    args = sys.argv[1:]
    if not args or args[0] in ('-h', '--help'):
        print(__doc__)
        return 0
    opts = [a for a in args if a.startswith('--')]
    words = [a for a in args if not a.startswith('--')]
    max_s = int(args[args.index('--max') + 1]) if '--max' in args else None
    words = [w for w in words if not w.isdigit()]
    names = LEVELS[words[0]] if len(words) == 1 and words[0] in LEVELS else words
    for n in names:
        if n not in CHECKS or n == 'settle':
            sys.exit(f't: unknown check or level "{n}"; tools/t --help')
    needs_settle = [i for i, n in enumerate(names) if n in ('frames', 'sleep', 'sleep1', 'sleep_rapid', 'powerd', 'darkwake', 'idle', 'sched', 'schedpi', 'schedframes')]
    if needs_settle:       # iOS refuses a sleep early in its start-up, and the governor takes over at 30 s
        names = names[:needs_settle[0]] + ['settle'] + names[needs_settle[0]:]
    stamp = time.strftime('%H%M%S')
    say(f'tools/t {" ".join(args)}: {" ".join(names) or "host only"}')
    t0 = time.time()

    jobs, est = job_text(names) if names else ('', 0)
    with timed('host+build'), cf.ThreadPoolExecutor(3) as pool:
        h = pool.submit(host_checks)
        k = pool.submit(build_kernel) if names else None
        u = pool.submit(build_userland, jobs) if names else None
        for name, ok, detail in h.result():
            check(name, ok, '' if ok else detail)
        if k:
            kmsg = k.result()
            say('  ' + kmsg)
            if 'FAILED' in kmsg:
                check('kernel build', False)
                return finish(t0, True)
        cache = None
        if u:
            cache, msg = u.result()
            say('  ' + msg)
    if not names or '--no-run' in opts or cache is None:
        return finish(t0, cache is None and bool(names))
    state = dict(stopped=None)
    with timed('run'):
        log, state, out = run_phone(cache, names, est, max_s, stamp)
    if log is None and not state.get('stopped'):
        check('run', False, out[-300:])
    else:
        with timed('analyze'):
            analyze(names, log, state, out)
    if log and all(v for _, v in verdicts) and '--keep' not in opts:
        for f in run_files(log)[1:]:
            os.remove(f)                      # (the copies are for a failure to be looked into)
    if '--keep' not in opts:
        try:
            os.remove('userland/rc.jobs.t')
        except OSError:
            pass
    return finish(t0, False)


def finish(t0, failed):
    total = time.time() - t0
    say('  timing: ' + ', '.join(f'{k} {v:.0f} s' for k, v in times.items()) + f'; total {total:.0f} s')
    ok = not failed and all(v for _, v in verdicts)
    say(f'RESULT: {"PASS" if ok else "FAIL"} ({sum(v for _, v in verdicts)} of {len(verdicts)} checks)')
    return 0 if ok else 1


if __name__ == '__main__':
    sys.exit(main())
